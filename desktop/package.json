{
  "name": "kb-desktop",
  "version": "0.1.0",
  "description": "Personal Knowledge Base desktop app (Electron + React + TypeScript).",
  "main": "dist/main/index.js",
  "author": "KB Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "dev:main": "tsc -w -p tsconfig.main.json",
    "dev:preload": "tsc -w -p tsconfig.preload.json",
    "dev:renderer": "vite",
    "dev": "concurrently -k -n main,preload,renderer,electron -c blue,yellow,green,magenta \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:renderer\" \"wait-on tcp:5173 && electron .\"",
    "start": "electron .",
    "lint": "tsc --noEmit -p tsconfig.json",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "wait-on": "^7.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0"
  }
}